# Photon Health sandbox (Neutron) — copy this file to demo/.env and fill in the values.
# Source: app.neutron.health › (avatar) Settings › Developers  (+ the Organization tab).
# demo/.env is gitignored — never commit real secrets. Use the copy buttons in the
# Neutron UI; the IDs contain easily-confused chars (0/O, l/1/I).

PHOTON_ENV=sandbox

# Machine-to-Machine Application (backend) — patient sync via the Clinical API
PHOTON_CLIENT_ID=
PHOTON_CLIENT_SECRET=

# Single Page Application (frontend) — Photon Elements auth inside the WebView
PHOTON_SPA_CLIENT_ID=

# Organization (Organization tab, or the org_… in your Neutron invite link)
PHOTON_ORG_ID=

# Optional — Elements signs in the logged-in provider, so this is usually not needed
# PHOTON_PROVIDER_ID=
